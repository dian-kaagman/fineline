# Fineline conversion worker - environment for running it natively (copy to .env and fill in).
# Placeholders below FAIL validation on purpose (SR-020): set real values before starting.

# Shared secret with the API (same value as the API's WORKER_TOKEN). At least 32 random
# characters, e.g. `openssl rand -base64 32`. The placeholder is refused at startup.
WORKER_TOKEN=replace-with-32+-random-chars

# HTTP port the worker listens on (default 8000).
PORT=8000

# Log level: fatal, error, warn, info or debug (Python names such as warning also work).
LOG_LEVEL=info

# Conversions running at the same time (default 2). More requests get 503 `busy` after
# waiting at most about one second (SR-004).
MAX_CONCURRENT_CONVERSIONS=2
