# Build-time variables (Vite inlines VITE_* into the bundle: never put secrets here).

# Contact address shown in the shop footer ("Questions? Email us at ...").
# Required for `npm run build`; the dev server and tests fall back to a placeholder.
VITE_CONTACT_EMAIL=hello@example.com

# Dev server only: where `npm run dev` proxies /api to. Default http://localhost:3000.
API_PROXY_TARGET=http://localhost:3000
