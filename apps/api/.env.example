# Fineline API configuration. Copy to .env (never commit .env) and fill in the secrets.
# The API validates every variable at startup and refuses to start, naming the variable, when one
# is missing or invalid. The secret placeholders below are rejected on purpose.

# PostgreSQL connection for the app (local development database).
DATABASE_URL=postgres://fineline:fineline@localhost:5432/fineline
# Dedicated database for `npm test`; its name must contain "test" (the tests wipe it).
TEST_DATABASE_URL=postgres://fineline:fineline@localhost:5432/fineline_test

# HTTP port the API listens on.
PORT=3000
# Directory for photos, drawings and frame photos (created if missing; keep it private).
STORAGE_DIR=./storage
# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Conversion worker (apps/worker) base URL and shared bearer secret (at least 32 characters,
# the same value as the worker's WORKER_TOKEN). Generate one with: openssl rand -base64 32
WORKER_URL=http://localhost:8000
WORKER_TOKEN=replace-with-32+-random-chars
# Milliseconds to wait for one conversion before answering conversion_unavailable.
WORKER_TIMEOUT_MS=30000
# Worker calls in flight at once; more uploads get 503 with Retry-After.
MAX_CONCURRENT_CONVERSIONS=2

# The single admin account. Generate the hash with `npm run hash-password` (reads the password
# from stdin, at least 12 characters) and paste the scrypt:... line here.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=run-npm-run-hash-password
# Admin session idle timeout in hours (sessions also end 24 hours after login).
SESSION_TTL_HOURS=8
# Secure flag on the admin cookie. Set to false only for plain http://localhost development.
COOKIE_SECURE=true

# One exact origin allowed for cross-origin requests, only for a split-origin dev setup.
# Leave empty normally: web and API share one origin through the proxy. `*` is refused.
CORS_ORIGIN=
# Proxies to trust for the client address: false when the API is reached directly, 1 behind nginx.
TRUST_PROXY=false

# Drawing area (mm) and stroke budget passed to the worker and enforced by the API's SVG check.
DRAWING_AREA_WIDTH_MM=180
DRAWING_AREA_HEIGHT_MM=267
MAX_STROKES=1500
MAX_TOTAL_STROKE_LENGTH_MM=25000

# Milliseconds between retention sweeps (also runs at startup).
RETENTION_SWEEP_INTERVAL_MS=3600000
