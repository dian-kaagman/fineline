# Fineline - environment for `docker compose up` (copy to .env and fill in).
# Secrets below are placeholders that FAIL validation on purpose (SR-020): generate real values.
# Each part (apps/api, apps/worker, apps/web) has its own .env.example for running it natively.

# --- Database (compose `db` service) ---
# PostgreSQL user, password and database created on first start; only reachable inside compose.
POSTGRES_USER=fineline
POSTGRES_PASSWORD=replace-with-a-local-db-password
POSTGRES_DB=fineline

# --- Shared secret between API and worker ---
# At least 32 random characters, e.g. `openssl rand -base64 32`. The placeholder is refused at startup.
WORKER_TOKEN=replace-with-32+-random-chars

# --- Admin login (one admin, BR-011) ---
# Username for the admin tool.
ADMIN_USERNAME=admin
# scrypt hash of the admin password (format scrypt:17:8:1:<salt>:<hash>, contains no `$`).
# Generate: `cd apps/api && npm ci && npm run hash-password` (type the password, 12+ characters),
# or after a first build: `docker compose run --rm --no-deps api node dist/scripts/hash-password.js`.
ADMIN_PASSWORD_HASH=run-npm-run-hash-password
# Idle lifetime of an admin session in hours (absolute limit is 24 h).
SESSION_TTL_HOURS=8
# Secure cookie flag. Keep true; browsers accept Secure cookies on http://localhost.
# Set false only if you serve the app over plain HTTP on another host name for testing.
COOKIE_SECURE=true

# --- Drawing rules (BR-003, BR-004) ---
# Drawing area in millimetres (paper minus margins). Default: A4 portrait with 15 mm margins.
DRAWING_AREA_WIDTH_MM=180
DRAWING_AREA_HEIGHT_MM=267
# Stroke budget per drawing: maximum number of strokes and total stroke length in millimetres.
MAX_STROKES=1500
MAX_TOTAL_STROKE_LENGTH_MM=25000

# --- Conversion ---
# How long the API waits for the worker, in milliseconds.
WORKER_TIMEOUT_MS=30000
# Conversions running at the same time (API and worker); more get "try again later" (SR-004).
MAX_CONCURRENT_CONVERSIONS=2

# --- Housekeeping ---
# How often the retention sweep deletes expired photos and drawings (BR-010), in milliseconds.
RETENTION_SWEEP_INTERVAL_MS=3600000
# Log level for API and worker: fatal, error, warn, info, debug.
LOG_LEVEL=info

# --- Web ---
# Host port for the shop and admin tool (http://localhost:8080).
WEB_PORT=8080
# Contact e-mail shown to customers (build-time; owner to confirm, Q-33).
VITE_CONTACT_EMAIL=hello@example.com
